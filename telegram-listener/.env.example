# Create an application at https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Created on first login; keep private and out of Git.
TELEGRAM_SESSION_FILE=./data/telegram.session

# Public channel usernames, without @
TELEGRAM_CHANNELS=soltrenchtrending,solwhaletrending,solearlytrending

# Must match SIGNAL_SOCKET_PATH in the Rust service
SIGNAL_SOCKET_PATH=/tmp/telsolsniper.sock
