{
  "name": "telsolsniper-telegram-listener",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=20.6.0"
  },
  "scripts": {
    "dev": "node --env-file=.env --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/parser.test.ts",
    "capture": "node --env-file=.env --import tsx scripts/capture-channels.mjs",
    "analyze": "python3 scripts/analyze-captures.py",
    "replay": "node --import tsx scripts/replay-parser.mjs"
  },
  "dependencies": {
    "bs58": "6.0.0",
    "teleproto": "1.232.1"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
